  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 286b4216db884fc198cab5d296bbc9cc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Note
  title: "Transkrypcja \u2013 108.7 MHz"
  text: "TRANSKRYPCJA \u2013 108.7 MHz (fragment)\n\n\"...je\u015Bli kto\u015B to s\u0142yszy, tu Agencja ECHO.\nTa strefa jest POZA ZASI\u0118GIEM naszych sieci. Jedyny kana\u0142 to radiostacja w biurze kierownika.\nPotrzebne: antena, lampa nadawcza, zasilacz.\nNadaj sygna\u0142, a przyjdziemy. Nie ufaj niczemu, co nosi uniform...\"\n\n[szum]"
  titleEn: "Transcript \u2013 108.7 MHz"
  textEn: "TRANSCRIPT \u2013 108.7 MHz (fragment)\n\n\"...if anyone can hear this, this is the ECHO Agency.\nThis zone is OUT OF RANGE of our networks. The only channel is the radio in the manager's office.\nRequired: antenna, transmitter tube, power supply.\nSend the signal and we will come. Don't trust anything that wears a uniform...\"\n\n[static]"
  paper: {fileID: 1995313746}
